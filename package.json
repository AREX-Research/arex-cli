{
  "name": "@arex-research/cli",
  "version": "1.0.0",
  "description": "Command-line interface and Agent Skill for the AREX public API",
  "keywords": [
    "arex",
    "cli",
    "search",
    "research",
    "agent-skill"
  ],
  "homepage": "https://github.com/AREX-Research/arex-cli#readme",
  "bugs": {
    "url": "https://github.com/AREX-Research/arex-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AREX-Research/arex-cli.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "arex": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:skill": "tsx scripts/generate-skill-module.ts",
    "predev": "npm run generate:skill",
    "dev": "tsx src/index.ts",
    "prebuild": "npm run generate:skill",
    "build": "tsup src/index.ts --format esm --platform node --target node22 --clean",
    "prebuild:binary": "npm run generate:skill",
    "build:binary": "bun scripts/build-binaries.ts current",
    "prebuild:binaries": "npm run generate:skill",
    "build:binaries": "bun scripts/build-binaries.ts all",
    "pretypecheck": "npm run generate:skill",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:skill",
    "test": "vitest run --dir tests",
    "test:watch": "vitest",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "skill:validate": "uvx --from skills-ref agentskills validate skills/arex",
    "validate": "npm run lint && npm run typecheck && npm test && npm run skill:validate && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@arex-research/ts-sdk": "^1.0.0",
    "@inquirer/password": "^4.0.23",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
